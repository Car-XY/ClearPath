# Server only. Never prefix these values with NEXT_PUBLIC_.
PHOTO_PROVIDER=anthropic
# For Claude, fill both values below. Use PHOTO_PROVIDER=openai for OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Choose a model available to your account that supports image input and strict
# Structured Outputs in the Responses API. The real key belongs in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Optional timeout, clamped to 10000–110000 milliseconds (default 110000).
PHOTO_ANALYSIS_TIMEOUT_MS=110000
